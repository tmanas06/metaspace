# ============================================================
# VirtualVerse Web — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the actual values.
# NEVER commit .env.local — it is gitignored.
#
# These values come from CONNECTION.md in virtualverse-server.
# The Cloudflare Tunnel URL changes on every Ubuntu restart —
# see DEPLOY.md § "Stale Tunnel URLs" for how to update them.
# ============================================================

# REST API base URL (NestJS via Cloudflare Tunnel)
# Used for: POST /livekit/token, any future REST calls
NEXT_PUBLIC_API_URL=https://your-tunnel.trycloudflare.com

# WebSocket base URL (Colyseus via Cloudflare Tunnel)
# Must use wss:// in production, ws:// only for local dev
NEXT_PUBLIC_WS_URL=wss://your-tunnel.trycloudflare.com

# LiveKit server URL (routed through same Cloudflare Tunnel)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-tunnel.trycloudflare.com

# ============================================================
# Smart Contract Addresses (Monad Testnet — Chain ID 10143)
# Deployed via: cd metaspace/contracts && forge script script/DeployContracts.s.sol --broadcast
# ============================================================
# AssetRegistry (ERC-1155): Avatars, cosmetics, decorations
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=0x...

# CredentialSBT (ERC-721 Soulbound): Badges, credentials, attendance
NEXT_PUBLIC_CREDENTIAL_SBT_ADDRESS=0x...

# AttendanceRegistry: Onchain check-ins / proof of attendance
NEXT_PUBLIC_ATTENDANCE_REGISTRY_ADDRESS=0x...